{
  "name": "restohub-print-agent",
  "version": "0.3.0-preview.1",
  "description": "Managed printing worker for RestoHub Local Agent",
  "main": "dist/main.js",
  "author": "Dinno Armenia",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "dev": "npm run build && electron .",
    "dist:win": "npm run test && npm run typecheck && npm run build && electron-builder --win nsis dir --publish never",
    "pack:win": "npm run test && npm run typecheck && npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "am.dinno.restohub.printagent",
    "productName": "RestoHub Print Worker",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "RestoHub-Print-Worker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
