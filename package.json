{
  "name": "restohub-print-agent",
  "version": "0.1.4",
  "description": "Reliable background printing for RestoHub venues",
  "main": "dist/main.js",
  "author": "Dinno Armenia",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "dev": "npm run build && electron .",
    "dist:win": "npm run test && npm run typecheck && npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": { "electron-log": "^5.4.3" },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "am.dinno.restohub.printagent",
    "productName": "RestoHub Print Agent",
    "asar": true,
    "files": ["dist/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis"], "artifactName": "RestoHub-Print-Agent-Setup-${version}.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
